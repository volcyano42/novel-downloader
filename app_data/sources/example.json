{
  "name": "example",
  "base_urls": ["example.com"],
  "charset": "utf-8",
  "search": {
    "url": "https://example.com/search?q={query}",
    "method": "GET",
    "list_selector": ".book-list > li",
    "fields": {
      "title": "h3 a",
      "author": ".author",
      "url": "h3 a @href",
      "cover_url": "img @src",
      "description": ".desc"
    }
  },
  "book_info": {
    "title": "h1",
    "author": ".author",
    "description": "#description",
    "cover_url": ".cover img @src",
    "tags": ".tags span"
  },
  "chapter_list": {
    "list_selector": "#chapter-list li",
    "fields": {
      "title": "a",
      "url": "a @href"
    }
  },
  "chapter_content": {
    "content_selector": "#content"
  }
}
